# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anonymous / publishable key (browser-safe) — Dashboard "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGc...your-anon-key-here

# Private: Supabase secret / service-role key — server-only (inserts traffic, admin API)
# The app expects SUPABASE_SECRET_KEY (createClient server). Same value as Dashboard "service role".
SUPABASE_SECRET_KEY=eyJhbGc...your-service-role-key-here

# Optional alias if you standardized on SERVICE_ROLE naming elsewhere — set one or mirror both:
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical URL for sitemap / Open Graph (production): https://www.flmango.com
NEXT_PUBLIC_SITE_URL=https://www.flmango.com

# MaxMind GeoIP Configuration (Free Tier)
# Sign up at https://www.maxmind.com/en/geolite2/signup to get credentials
# Download GeoLite2-City.mmdb and place in lib/geoip/ directory
# For free tier, you don't need to set these (just have the .mmdb file)
# For paid API-based lookups in the future:
# MAXMIND_ACCOUNT_ID=your_account_id
# MAXMIND_LICENSE_KEY=your_license_key

# Optional: Disable geolocation during testing to avoid quota burndown
# MAXMIND_DISABLED=false

# Resend Email Service (Test Mode)
# Get a test API key from https://resend.com/api-keys
RESEND_API_KEY=re_test_...
ADMIN_EMAIL=sinhtx@gmail.com
